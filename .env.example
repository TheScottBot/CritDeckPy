# Copy this file to .env in the directory the bot runs from, then set
# DISCORD_TOKEN.
# A variable set in the environment wins over the same key in .env.
# A missing token or a bad value stops startup with the setting's name.

# Required: the bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional. Each is shown with its default.

# Prefix for the typed backup commands, for example ?newdeck 7.
# COMMAND_PREFIX=?

# Server ids, separated by commas, to register slash commands to straight away.
# Use this for a test server while developing.
# GUILD_IDS=

# Set to true once, at release, to register slash commands in every server.
# SYNC_GLOBAL_COMMANDS=false

# Where the deck files live: player-deck.json, extensions/ and special-levels/.
# DECK_DIRECTORY=decks

# The rolling log file; the bot also logs to stderr.
# LOG_FILE=logs/critdeck.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUPS=5
